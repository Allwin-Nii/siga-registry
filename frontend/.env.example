# Public and administrator API base URL. Include the /api path; never hardcode a production address.
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Optional browser-restricted Google Maps key. Enables Places suggestions and a
# draggable pin in administrator entity location management.
VITE_GOOGLE_MAPS_API_KEY=
