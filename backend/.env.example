# HTTP server
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Administrator sessions. Set COOKIE_SECURE=true behind HTTPS in production.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# MySQL 8 connection. Use a dedicated least-privilege application account.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=siga_registry_app
DATABASE_PASSWORD=replace_with_a_secure_password
DATABASE_NAME=siga_registry
